:80 {
    root * /srv

    # Serve static files; return a genuine 404 if the file doesn't exist
    # (do NOT fall back to index.html — Next.js static export has a real
    # HTML file for every route, and a fake 200 would pollute caches).
    file_server

    # Next.js static export writes /foo/index.html and /foo.html.
    # Try both variants so clean URLs work, but stop there.
    try_files {path} {path}.html {path}/index.html

    # Prevent 404 (and other error) responses from being cached by
    # browsers or intermediate proxies.
    handle_errors {
        header Cache-Control "no-store"
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }

    # 缓存策略：默认协商缓存（no-cache = 每次发版浏览器都会校验拿到新页面，
    # 避免旧 HTML 引用已不存在的资源路径导致编辑器报「使用文档时出错」）；
    # 仅内容寻址/版本化产物放行一年 immutable。
    header Cache-Control "no-cache"

    # OnlyOffice 内核资源（/v<版本>-<hash>/…）：内容随版本目录固定，必须长期
    # 缓存 + 传输压缩。
    #
    # 注意：这里**不能**用 matcher 形式的 header——它会被上面的默认
    # `header Cache-Control "no-cache"` 覆盖（实测 /x2t/* 与 /v*-*/* 都中招），
    # 结果是每次打开文档浏览器都要重新校验/下载整棵内核树（sdk-all.js 8.9MB、
    # app.js 2.2MB，且未压缩），表现为"打开 Word 一直转圈"。用 handle 兜住，
    # 求值顺序确定；encode 让这些未预压缩的 JS 走 gzip/zstd（8.9MB → 2.4MB）。
    # Caddy 的 path 匹配器只支持结尾通配（/v*-*/* 与 /v*/* 都不匹配），
    # 这里用正则匹配器，版本目录变了也不用改配置；排除 v9.3.0.24-1 —— 那是
    # 极早期缓存的兼容前缀，由下面的 handle_path 重写到当前版本目录。
    @onlyoffice_assets {
        path_regexp ^/v[^/]+/
        not path /v9.3.0.24-1/*
    }
    handle @onlyoffice_assets {
        header Cache-Control "public, max-age=31556952, immutable"
        encode zstd gzip
        file_server
    }

    # Next.js content-hashed chunks (1 year)
    @next_static {
        path /_next/static/*
    }
    header @next_static Cache-Control "public, max-age=31556952, immutable"

    # x2t 运行时（brotli 压缩的 wasm 近 10MB + worker js）：内容随版本固定，
    # 必须长期缓存——默认的 no-cache 会让浏览器每次打开文档都重新下载/校验这
    # 近 10MB，表现为"打开 Word 一直转圈"。
    # 用 handle 单独兜住：matcher 形式的 header 会被上面的默认规则覆盖，handle
    # 的求值顺序是确定的。
    handle /x2t/* {
        header Cache-Control "public, max-age=31556952, immutable"
        @x2t_wasm_file path *.wasm
        header @x2t_wasm_file Content-Encoding br
        file_server
    }

    # Brotli-encoded x2t versioned bundles
    @x2t_suffix {
        path /x2t-*/*
    }
    header @x2t_suffix Content-Encoding br
    header @x2t_suffix Cache-Control "public, max-age=31556952, immutable"

    # 兼容层：极早期前端缓存仍请求 /v9.3.0.24-1，转发到当前内核目录，
    # 老用户无需清浏览器缓存即可继续使用（配合上方 no-cache 策略过渡）
    handle_path /v9.3.0.24-1/* {
        rewrite * /v9.3.1-1{http.request.uri.path}
    }
}
