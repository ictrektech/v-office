[
  {
    "id": "disclosure",
    "name": "专利交底书",
    "description": "从材料挖专利点 → 轻量查新 → 按国知局口径成文，产出 Markdown + Word。",
    "kind": "disclosure",
    "skillEntry": "skills/patent-disclosure",
    "outputs": [
      "交底书.md",
      "交底书.docx",
      "查新与区别定位.md"
    ],
    "fields": [
      {
        "key": "title",
        "label": "发明名称",
        "hint": "主题 + 类型，避免商标与夸大用词",
        "required": true
      },
      {
        "key": "field",
        "label": "技术领域",
        "hint": "本发明所属的技术领域",
        "required": true
      },
      {
        "key": "background",
        "label": "背景技术",
        "hint": "现有技术方案及其出处",
        "required": true
      },
      {
        "key": "defect",
        "label": "现有技术缺陷",
        "hint": "逐条列问题，不要空喊创新性强",
        "required": true
      },
      {
        "key": "purpose",
        "label": "发明目的",
        "hint": "要解决的技术问题",
        "required": true
      },
      {
        "key": "solution",
        "label": "技术方案",
        "hint": "必要技术特征 + 从属特征",
        "required": true,
        "inferred": true
      },
      {
        "key": "effects",
        "label": "有益效果",
        "hint": "与缺陷一一对应",
        "required": true
      },
      {
        "key": "embodiments",
        "label": "实施例",
        "hint": "至少一个可实施的具体方案",
        "required": true
      },
      {
        "key": "figures",
        "label": "附图说明",
        "hint": "框图 / 结构图 / 流程图编号与说明",
        "inferred": true
      },
      {
        "key": "alternatives",
        "label": "替代方案",
        "hint": "扩展保护范围用",
        "inferred": true
      },
      {
        "key": "uncertain",
        "label": "待确认清单",
        "hint": "未披露部件只写这里，不进权要",
        "inferred": true
      }
    ],
