      {
        "key": "claimStrategy",
        "label": "权要布局",
        "hint": "独权必要特征 + 从属阶梯",
        "required": true
      },
      {
        "key": "supportCheck",
        "label": "支持性自查",
        "hint": "权要特征需在说明书有支撑"
      }
