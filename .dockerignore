# Exclude dev/build artifacts — these are rebuilt inside Docker
node_modules
.next
# 本地 dev / 试构建目录（next.config.ts 的 NEXT_DIST_DIR，dev 用 .next-dev），
# 只有 turbopack 缓存没有它照样能构建；漏排会让上下文多出几百 MB，
# COPY . . 从几秒变成五六分钟
.next-dev
.next-*
out

# Git & editor
.git
.gitignore
.gitattributes
.vscode

# Deployment configs not needed inside the image
.vercel
.edgeone
.wrangler
vercel.json
wrangler.json
wrangler.jsonc
edgeone.json
ictrek.app
UPSTREAM
server
# 专利技能包只有 storage 镜像需要；web 镜像用不到，531 个文件只会拖慢 COPY . .
vendor
.github

# Docs & examples
README.md
README.zh-CN.md
docs
examples

# Large OnlyOffice static assets — they come from the documentserver stage,
# so including them in the build context just wastes time and bandwidth.
public/v9.3*

# AI 助手插件本地镜像（scripts/sync-ai-assistant.sh 生成的本地 dev 副本，
# 不进 git；生产插件由 agentic-search 应用托管）
public/ai-assistant

# Misc
.DS_Store
*.pem
*.local
.pnpm-debug.log*

# local test scripts — never into image
.trae-test

# 本地测试素材（不进镜像）
/samples/

# 专利端到端实测目录：跑批脚本 + 真实项目素材 + 实测报告，纯测试资产，
# 不进 git 也不进镜像（.gitignore 里已整目录排除）
/scripts/patent-e2e/

# 热修复备份（仅本地排查用，已在 .gitignore）
/.hotfix-backup/
