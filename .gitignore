# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# 本地 dev 的构建目录（见 next.config.ts 的 NEXT_DIST_DIR：dev 用 .next-dev，
# 与 build 的 .next 隔离）。**必须在这里忽略**，否则 Tailwind v4 的自动内容
# 探测会把 .next-dev 下的 turbopack 缓存（.sst 二进制）、日志、编译产物一并
# 当源码扫描，扫出 `bg-[4dot=!]` 这类垃圾类名 → 生成出无法解析的 CSS →
# lightningcss 报 "Parsing CSS source code failed" → 整站样式表作废、页面白屏
# （2026-10-13 本地就是这么白屏的）。
/.next-dev/

# playwright-cli（浏览器自动化）的工作目录：快照、控制台日志、截图都落在这里，
# 是本地调试产物，不该进仓库。
/.playwright-cli/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.local

# Tencent Cloud EdgeOne
.env
.edgeone/*
.tef_dist/*
  
# 构建时从技能仓库同步进来的技能包（见 server/skills/README.md）
/server/skills/*
!/server/skills/README.md

# local test scripts only — never commit
.trae-test

# python bytecode (server/ 本地运行时生成)
__pycache__/
*.pyc

# 文档/素材目录（使用文档、宣传稿件等，不进 git；同样已在 .dockerignore 中排除）
/docs/

# 本地 OnlyOffice 内核（从平台镜像拷的，仅本地 dev 用；生产由应用镜像自带，永不入库）
/public/v9.3.1-1/
/public/runtime-config.js

# 本地测试素材（不入 git）
/samples/

# 热修复备份（本地回滚用，不入 git）
/.hotfix-backup/
