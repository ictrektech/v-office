# Exclude dev/build artifacts — these are rebuilt inside Docker
node_modules
.next
out

# Git & editor
.git
.gitignore
.gitattributes
.vscode

# Deployment configs not needed inside the image
.vercel
.edgeone
.wrangler
vercel.json
wrangler.json
wrangler.jsonc
edgeone.json
ictrek.app
UPSTREAM
server
.github

# Docs & examples
README.md
README.zh-CN.md
docs
examples

# Large OnlyOffice static assets — they come from the documentserver stage,
# so including them in the build context just wastes time and bandwidth.
public/v9.3*

# 本地 dev 用的 AI 插件符号链接（指向仓库外 agentic-search 的插件目录），
# 构建上下文里目标不存在，悬空链接会让 next build 扫 public/ 时 stat 失败。
# 生产镜像不需要它：VOS 下插件由 agentic-search 应用托管。
public/ai-assistant

# Misc
.DS_Store
*.pem
*.local
.pnpm-debug.log*
